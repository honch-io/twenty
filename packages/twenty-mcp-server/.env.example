# The Twenty instance this MCP server talks to.
TWENTY_BASE_URL=http://localhost:3000

# HTTP transport (primary, for hosting on the Mac mini).
# The server binds to 127.0.0.1 only; expose it publicly via a tunnel (see README).
TWENTY_MCP_HTTP_PORT=3010

# Comma-separated CORS origin allowlist for the HTTP transport.
# Leave empty to disallow browser cross-origin requests (server-to-server is unaffected).
TWENTY_MCP_ALLOWED_ORIGINS=

# Enable the raw_graphql escape-hatch tool (off by default).
TWENTY_MCP_ENABLE_RAW_GRAPHQL=false

# stdio transport only (local dev): the Twenty API key the server uses.
# In HTTP mode the key is supplied per-request via the Authorization header instead.
TWENTY_API_KEY=
