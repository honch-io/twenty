{
  "name": "twenty-mcp-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/twenty-mcp-server/src",
  "projectType": "application",
  "tags": ["scope:backend"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["^build"],
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          "npx rimraf dist && npx vite build",
          "tsgo -p tsconfig.lib.json --declaration --emitDeclarationOnly --outDir dist --rootDir src --composite false && npx tsc-alias -p tsconfig.lib.json --outDir dist"
        ],
        "parallel": false
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node dist/cli.mjs --http"
      }
    },
    "typecheck": {},
    "lint": {},
    "fmt": {
      "options": {
        "files": "src"
      },
      "configurations": {
        "fix": {}
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "npx vitest run"
      },
      "configurations": {
        "ci": {
          "command": "npx vitest run --coverage"
        },
        "watch": {
          "command": "npx vitest"
        }
      }
    }
  }
}
